{
  "framework": "vite",
  "outputDirectory": "dist",
  "alias": ["barzzo-parceiro.vercel.app", "barzzo-parceiro-dev.vercel.app"],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    { "path": "/api/cron/renovar-assinaturas", "schedule": "0 12 * * *" },
    { "path": "/api/cron/alertas-assinatura", "schedule": "0 12 * * *" }
  ]
}
